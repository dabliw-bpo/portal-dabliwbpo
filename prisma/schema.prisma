generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  /// Equipe do BPO — visão total.
  ADMIN
  /// Equipe do BPO — enxerga os departamentos que gerencia, em todos os clientes.
  GESTOR
  /// Equipe do BPO — enxerga as próprias atividades.
  OPERADOR
  COMPANY_HR
  COLLABORATOR
  CLIENT
}

enum DocumentType {
  CONTRACT
  PAYSLIP
  VACATION_REQUEST
  OTHER
}

enum DocumentStatus {
  PENDING_SIGNATURE
  SIGNED
  ARCHIVED
}

enum VacationStatus {
  REQUESTED
  APPROVED
  REJECTED
  DOCUMENT_GENERATED
}

/// Mirrors the fields printed on the Receita Federal "Cartão CNPJ"
/// (Comprovante de Inscrição e de Situação Cadastral). `name` holds the
/// NOME EMPRESARIAL (razão social); everything below is transcribed from
/// the card and is optional so a company can be created before the card
/// is at hand.
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  /// Logo da empresa no bucket público `avatars`, exibida no cabeçalho do
  /// portal para quem pertence a ela.
  logoPath  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeName           String?
  openingDate         DateTime?
  branchType          String?
  legalNature         String?
  companySize         String?
  mainActivity        String?
  secondaryActivities String?

  street       String?
  streetNumber String?
  complement   String?
  district     String?
  city         String?
  state        String?
  zipCode      String?

  email String?
  phone String?

  /// Sócio administrador: recebe o comprovante a cada assinatura concluída.
  partnerName  String?
  partnerEmail String?

  /// Cor da marca (#RRGGBB), usada na imagem dos dados bancários.
  brandColor String?
  /// Layout da imagem de dados bancários: cada cliente recebe a sua arte.
  cardStyle  String?

  /// A matriz é o próprio BPO: a equipe dela atende a carteira de clientes,
  /// em vez de ser colaboradora de um cliente. Só uma empresa é matriz.
  isHeadquarters Boolean @default(false)

  federalEntity            String?
  registrationStatus       String?
  registrationStatusDate   DateTime?
  registrationStatusReason String?
  specialStatus            String?
  specialStatusDate        DateTime?

  users                User[]
  bankAccounts         BankAccount[]
  contaAzulIntegration ContaAzulIntegration?
  serviceContracts     ServiceContract[]
  tasks                Task[]
  paymentReceipts      PaymentReceipt[]
}

model BankAccount {
  id            String   @id @default(cuid())
  companyId     String
  bankName      String
  bankCode      String?
  agency        String
  accountNumber String
  cnpj          String?
  pixKey        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceContracts ServiceContract[]
  tasks            Task[]

  @@index([companyId])
}

model ContaAzulIntegration {
  id           String   @id @default(cuid())
  companyId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  companyId           String?
  avatarPath          String?
  whatsapp            String?
  /// Dado pessoal sensível (LGPD): visível apenas para admin e RH da empresa.
  cpf                 String?
  admissionDate       DateTime?
  birthDate           DateTime?
  /// Ano do último parabéns enviado, para o envio diário não repetir.
  birthdayGreetedYear Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  ownedDocuments      Document[]           @relation("DocumentOwner")
  uploadedDocuments   Document[]           @relation("DocumentUploader")
  signatures          Signature[]
  vacationRequests    VacationRequest[]    @relation("VacationCollaborator")
  reviewedVacations   VacationRequest[]    @relation("VacationReviewer")
  passwordResetTokens PasswordResetToken[]

  departmentMemberships DepartmentMember[]
  contractAssignments   ServiceContract[]   @relation("ContractAssignee")
  assignedTasks         Task[]              @relation("TaskAssignee")
  completedTasks        Task[]              @relation("TaskCompleter")
  checkedChecklistItems TaskChecklistItem[]
  taskHistoryEntries    TaskHistory[]
  paymentReceipts       PaymentReceipt[]    @relation("ReceiptCollaborator")

  @@index([companyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id               String         @id @default(cuid())
  title            String
  type             DocumentType
  status           DocumentStatus @default(PENDING_SIGNATURE)
  filePath         String
  fileName         String
  mimeType         String
  fileSize         Int
  ownerUserId      String
  uploadedByUserId String
  /// Competência (YYYY-MM) — usada pelos holerites mensais.
  referenceMonth   String?
  /// Relatório de auditoria gerado no momento da assinatura.
  auditFilePath    String?
  /// SHA-256 do arquivo original, impresso no relatório para conferência.
  fileHash         String?
  /// Preenchido quando o documento é a evidência de entrega de uma atividade.
  /// Um documento pertence a no máximo uma tarefa, então basta a FK direta —
  /// não há necessidade de tabela de junção.
  taskId           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner           User             @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  uploadedBy      User             @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  signature       Signature?
  vacationRequest VacationRequest?
  paymentReceipt  PaymentReceipt?
  task            Task?            @relation(fields: [taskId], references: [id])

  @@index([ownerUserId])
  @@index([taskId])
}

model Signature {
  id         String   @id @default(cuid())
  documentId String   @unique
  userId     String
  signerName String
  signedAt   DateTime @default(now())
  ipAddress  String
  userAgent  String
  /// Assinatura manuscrita capturada no ato, como data URL PNG. Nulo apenas
  /// para as assinaturas registradas antes da captura passar a ser exigida.
  imageData  String?

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model VacationRequest {
  id                 String         @id @default(cuid())
  collaboratorUserId String
  startDate          DateTime
  /// Nulo nas solicitações feitas pelo novo fluxo: o colaborador escolhe só o
  /// primeiro dia e a contabilidade apura o restante.
  endDate            DateTime?
  /// Quantos dias, ou venda de dias. Nulo nos registros anteriores à opção.
  option             String?
  notes              String?
  status             VacationStatus @default(REQUESTED)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNotes        String?
  documentId         String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  collaborator User      @relation("VacationCollaborator", fields: [collaboratorUserId], references: [id])
  reviewedBy   User?     @relation("VacationReviewer", fields: [reviewedByUserId], references: [id])
  document     Document? @relation(fields: [documentId], references: [id])

  @@index([collaboratorUserId])
}

/// Recibo de pagamento avulso emitido para um colaborador. Nome completo e
/// CPF vêm sempre do `User` no momento da impressão, nunca copiados aqui, para
/// que uma correção cadastral valha também para recibos já emitidos.
model PaymentReceipt {
  id                         String   @id @default(cuid())
  companyId                  String
  collaboratorUserId         String
  description                String
  amountCents                Int
  issuedAt                   DateTime @default(now())
  /// Assinatura da empresa, coletada pelo admin antes do envio.
  companySignatureImage      String?
  /// Mantida para os recibos assinados presencialmente, antes do envio ao
  /// portal. Nos novos, a assinatura do colaborador vive no `Signature` do
  /// documento gerado, com a mesma trilha de auditoria do holerite.
  collaboratorSignatureImage String?
  /// Documento gerado ao enviar para assinatura; nulo enquanto o recibo é
  /// rascunho e ainda pode ter valor e descrição editados.
  documentId                 String?  @unique
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collaborator User      @relation("ReceiptCollaborator", fields: [collaboratorUserId], references: [id])
  document     Document? @relation(fields: [documentId], references: [id])

  @@index([companyId])
  @@index([collaboratorUserId])
}

// ---------------------------------------------------------------------------
// Atividades recorrentes
//
// O eixo é: Service (o que sabemos fazer) → ServiceContract (o que o cliente
// contratou, e com que periodicidade) → Task (a ocorrência de um período).
// O gerador em `src/lib/atividades/gerar.ts` é quem materializa as tarefas.
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
  members  DepartmentMember[]
  tasks    Task[]
}

model DepartmentMember {
  id           String  @id @default(cuid())
  departmentId String
  userId       String
  /// Um GESTOR só enxerga os departamentos onde este campo é verdadeiro.
  manager      Boolean @default(false)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

enum ServiceNature {
  RECORRENTE
  SOB_DEMANDA
}

/// Granularidade da tarefa gerada. É propriedade do serviço, não do contrato:
/// conciliação é sempre por conta, folha é sempre por empresa.
enum ServiceScope {
  EMPRESA
  CONTA_BANCARIA
  /// Reservado para as rotinas de RH (admissão, férias, rescisão).
  COLABORADOR
}

model Service {
  id               String        @id @default(cuid())
  name             String
  departmentId     String
  nature           ServiceNature @default(RECORRENTE)
  scope            ServiceScope  @default(EMPRESA)
  /// Quando verdadeiro, a tarefa só conclui com documento anexado.
  requiresDocument Boolean       @default(false)
  estimatedMinutes Int?
  description      String?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  department        Department              @relation(fields: [departmentId], references: [id])
  checklistTemplate ChecklistTemplateItem[]
  contracts         ServiceContract[]
  tasks             Task[]

  @@index([departmentId])
}

model ChecklistTemplateItem {
  id        String  @id @default(cuid())
  serviceId String
  order     Int
  text      String
  required  Boolean @default(false)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, order])
}

enum RecurrenceType {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum NonBusinessDayAdjustment {
  ANTECIPAR
  POSTERGAR
  MANTER
}

model ServiceContract {
  id            String  @id @default(cuid())
  companyId     String
  serviceId     String
  /// Obrigatório quando service.scope = CONTA_BANCARIA. A condicional é
  /// validada em Zod — o Prisma não consegue expressá-la entre tabelas.
  bankAccountId String?

  recurrenceType RecurrenceType
  /// MENSAL/TRIMESTRAL/ANUAL — 1 a 31, com clamp no último dia do mês.
  dayOfMonth     Int?
  /// SEMANAL/QUINZENAL — 0=domingo … 6=sábado.
  weekday        Int?
  /// TRIMESTRAL/ANUAL — meses aplicáveis (1 a 12).
  months         Int[]
  /// Hora limite legal, "HH:mm". O corte bancário mora aqui.

  adjustment       NonBusinessDayAdjustment @default(POSTERGAR)
  /// Prazo meta = prazo legal menos N dias úteis.
  targetOffsetDays Int                      @default(1)

  assigneeId String?
  startsOn   DateTime
  endsOn     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  assignee    User?        @relation("ContractAssignee", fields: [assigneeId], references: [id])
  tasks       Task[]

  @@unique([companyId, serviceId, bankAccountId])
  @@index([active])
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  CONCLUIDA
  CANCELADA
}

enum TaskOrigin {
  RECORRENTE
  ORDEM_SERVICO
  SOLICITACAO_CLIENTE
  EVENTO
}

model Task {
  id                String  @id @default(cuid())
  companyId         String
  serviceId         String
  serviceContractId String?
  bankAccountId     String?
  departmentId      String

  periodStart   DateTime
  periodEnd     DateTime
  dueDateLegal  DateTime
  dueDateTarget DateTime

  assigneeId String?
  status     TaskStatus @default(PENDENTE)
  origin     TaskOrigin @default(RECORRENTE)

  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service             @relation(fields: [serviceId], references: [id])
  contract    ServiceContract?    @relation(fields: [serviceContractId], references: [id])
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  department  Department          @relation(fields: [departmentId], references: [id])
  assignee    User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy User?               @relation("TaskCompleter", fields: [completedById], references: [id])
  checklist   TaskChecklistItem[]
  history     TaskHistory[]
  documents   Document[]

  /// Idempotência do gerador: um contrato produz no máximo uma tarefa por
  /// período. Sem isso, rodar o gerador duas vezes duplica obrigação.
  @@unique([serviceContractId, periodStart])
  @@index([status, dueDateLegal])
  @@index([assigneeId, status])
  @@index([companyId, status])
  @@index([departmentId, status])
}

model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String
  order       Int
  text        String
  required    Boolean   @default(false)
  checkedAt   DateTime?
  checkedById String?

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkedBy User? @relation(fields: [checkedById], references: [id])

  @@unique([taskId, order])
}

model TaskHistory {
  id         String      @id @default(cuid())
  taskId     String
  fromStatus TaskStatus?
  toStatus   TaskStatus
  authorId   String
  note       String?
  createdAt  DateTime    @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model GenerationRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  horizonEnd    DateTime
  tasksCreated  Int       @default(0)
  tasksSkipped  Int       @default(0)
  errors        String?
  triggeredById String?
}
