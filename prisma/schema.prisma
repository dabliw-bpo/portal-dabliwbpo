generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COMPANY_HR
  COLLABORATOR
  CLIENT
}

enum DocumentType {
  CONTRACT
  PAYSLIP
  VACATION_REQUEST
  OTHER
}

enum DocumentStatus {
  PENDING_SIGNATURE
  SIGNED
  ARCHIVED
}

enum VacationStatus {
  REQUESTED
  APPROVED
  REJECTED
  DOCUMENT_GENERATED
}

/// Mirrors the fields printed on the Receita Federal "Cartão CNPJ"
/// (Comprovante de Inscrição e de Situação Cadastral). `name` holds the
/// NOME EMPRESARIAL (razão social); everything below is transcribed from
/// the card and is optional so a company can be created before the card
/// is at hand.
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeName           String?
  openingDate         DateTime?
  branchType          String?
  legalNature         String?
  companySize         String?
  mainActivity        String?
  secondaryActivities String?

  street       String?
  streetNumber String?
  complement   String?
  district     String?
  city         String?
  state        String?
  zipCode      String?

  email String?
  phone String?

  federalEntity            String?
  registrationStatus       String?
  registrationStatusDate   DateTime?
  registrationStatusReason String?
  specialStatus            String?
  specialStatusDate        DateTime?

  users                User[]
  bankAccounts         BankAccount[]
  contaAzulIntegration ContaAzulIntegration?
}

model BankAccount {
  id            String   @id @default(cuid())
  companyId     String
  bankName      String
  bankCode      String?
  agency        String
  accountNumber String
  cnpj          String?
  pixKey        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ContaAzulIntegration {
  id           String   @id @default(cuid())
  companyId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  companyId          String?
  avatarPath         String?
  whatsapp           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  ownedDocuments      Document[]           @relation("DocumentOwner")
  uploadedDocuments   Document[]           @relation("DocumentUploader")
  signatures          Signature[]
  vacationRequests    VacationRequest[]    @relation("VacationCollaborator")
  reviewedVacations   VacationRequest[]    @relation("VacationReviewer")
  passwordResetTokens PasswordResetToken[]

  @@index([companyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id               String         @id @default(cuid())
  title            String
  type             DocumentType
  status           DocumentStatus @default(PENDING_SIGNATURE)
  filePath         String
  fileName         String
  mimeType         String
  fileSize         Int
  ownerUserId      String
  uploadedByUserId String
  /// Competência (YYYY-MM) — usada pelos holerites mensais.
  referenceMonth   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner           User             @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  uploadedBy      User             @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  signature       Signature?
  vacationRequest VacationRequest?

  @@index([ownerUserId])
}

model Signature {
  id         String   @id @default(cuid())
  documentId String   @unique
  userId     String
  signerName String
  signedAt   DateTime @default(now())
  ipAddress  String
  userAgent  String
  /// Assinatura manuscrita capturada no ato, como data URL PNG. Nulo apenas
  /// para as assinaturas registradas antes da captura passar a ser exigida.
  imageData  String?

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model VacationRequest {
  id                 String         @id @default(cuid())
  collaboratorUserId String
  startDate          DateTime
  endDate            DateTime
  notes              String?
  status             VacationStatus @default(REQUESTED)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewNotes        String?
  documentId         String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  collaborator User      @relation("VacationCollaborator", fields: [collaboratorUserId], references: [id])
  reviewedBy   User?     @relation("VacationReviewer", fields: [reviewedByUserId], references: [id])
  document     Document? @relation(fields: [documentId], references: [id])

  @@index([collaboratorUserId])
}
