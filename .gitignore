# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma
/prisma/dev.db
/prisma/dev.db-journal

# uploaded documents
/storage/documents/*
!/storage/documents/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
/.claude/settings.local.json

# unrelated local files (not part of this project)
/Auditoria BPO - Análises de Demonstrativos/briefing_imersao_ia.docx
/Auditoria BPO - Análises de Demonstrativos/previsao_faturamento.xlsx
/Auditoria BPO - Análises de Demonstrativos/teste.txt

# local secrets
*.local

# supabase CLI local state
/supabase/.temp

# Auditoria BPO squad: own node_modules (separate package.json)
/Auditoria BPO - Análises de Demonstrativos/node_modules

# Auditoria BPO squad: sensitive financial exports and generated reports
/Auditoria BPO - Análises de Demonstrativos/inputs/*
!/Auditoria BPO - Análises de Demonstrativos/inputs/README.md
!/Auditoria BPO - Análises de Demonstrativos/inputs/*/
/Auditoria BPO - Análises de Demonstrativos/inputs/*/*
!/Auditoria BPO - Análises de Demonstrativos/inputs/*/.gitkeep
/Auditoria BPO - Análises de Demonstrativos/outputs/*
!/Auditoria BPO - Análises de Demonstrativos/outputs/*/
/Auditoria BPO - Análises de Demonstrativos/outputs/*/*
!/Auditoria BPO - Análises de Demonstrativos/outputs/*/.gitkeep

# Auditoria BPO squad: client-dropped source reports, real client financial data
/Auditoria BPO - Análises de Demonstrativos/EGM TRANSPORTES/
